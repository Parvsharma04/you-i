DATABASE_URL="postgresql://username:password@localhost:5432/himandher?schema=public"
GEMINI_API_KEY="your-gemini-api-key-here"
FRONTEND_URL="http://localhost:3000"
# Comma-separated list of allowed browser origins for CORS (HTTP + socket.io).
# Falls back to FRONTEND_URL, then http://localhost:3000, if unset. Mobile
# clients send no Origin header and are unaffected by this setting.
ALLOWED_ORIGINS="http://localhost:3000"
# Interface the HTTP server binds to. 0.0.0.0 makes the backend reachable
# from other devices on the LAN (e.g. an Android phone running Expo Go).
# Use 127.0.0.1 only when you intentionally want localhost-only access.
HOST=0.0.0.0
PORT=8081
