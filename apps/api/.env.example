DATABASE_URL="postgresql://username:password@localhost:5432/himandher?schema=public"
GEMINI_API_KEY="your-gemini-api-key-here"
FRONTEND_URL="http://localhost:3000"
# Comma-separated list of allowed browser origins for CORS (HTTP + socket.io).
# Falls back to FRONTEND_URL, then http://localhost:3000, if unset. Mobile
# clients send no Origin header and are unaffected by this setting.
ALLOWED_ORIGINS="http://localhost:3000"
# Set to "false" once every client sends X-Player-Id instead of playerId in
# the request body (only affects POST /answer).
ALLOW_LEGACY_PLAYER_ID_BODY="true"
PORT=3001
