{
  "name": "you-i",
  "version": "0.0.0",
  "private": true,
  "packageManager": "pnpm@10.27.0",
  "scripts": {
    "dev": "pnpm --parallel --filter \"./apps/*\" run dev",
    "build": "pnpm --recursive --filter \"./apps/*\" run build",
    "typecheck": "pnpm --recursive --filter \"./apps/*\" --filter \"./packages/*\" run typecheck",
    "lint": "pnpm --recursive --filter \"./apps/*\" run lint",
    "db:migrate": "pnpm --filter @youandi/api run db:migrate"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@parcel/watcher",
      "@prisma/client",
      "@prisma/engines",
      "prisma",
      "sharp",
      "unrs-resolver"
    ]
  }
}
